{
  "label": "Unreal Engine 4 and 5 games in UEVR: the engine's own quality groups, the same in every Unreal game",
  "notes": "Every Unreal game has the same scalability groups (sg.*) and r.ScreenPercentage. They are written to UEVR's user_script.txt in the game's UEVR profile folder, which UEVR runs as console lines when it starts, and sent live through the UEVR connector (uevr-mcp, port 8899) when it is running, so no restart is needed. [inferred-static 2026-11-21: the file and the connector's /api/console/command route are read from UEVR's and uevr-mcp's files; not yet proven in a game]. A game that locks a cvar ignores it: the measurement then shows no change, and that setting should be marked off for that game.",
  "knobs": [
    {"id": "screen_pct", "label": "Picture sharpness (render resolution, %)", "kind": "console_script",
     "file": "%APPDATA%\\UnrealVRMod\\{exe_stem}\\user_script.txt", "key": "r.ScreenPercentage",
     "steps": ["60", "70", "80", "90", "100", "110", "120"], "default": 4, "floor": 1,
     "shows": 3, "cost": 3, "live": "uevr_http", "restart": false},
    {"id": "shadows", "label": "Shadows", "kind": "console_script",
     "file": "%APPDATA%\\UnrealVRMod\\{exe_stem}\\user_script.txt", "key": "sg.ShadowQuality",
     "steps": ["0", "1", "2", "3"], "default": 3, "floor": 1, "shows": 2, "cost": 3, "live": "uevr_http", "restart": false},
    {"id": "gi", "label": "Global lighting (Unreal 5)", "kind": "console_script",
     "file": "%APPDATA%\\UnrealVRMod\\{exe_stem}\\user_script.txt", "key": "sg.GlobalIlluminationQuality",
     "steps": ["0", "1", "2", "3"], "default": 3, "floor": 1, "shows": 2, "cost": 3, "live": "uevr_http", "restart": false},
    {"id": "post", "label": "Post-processing", "kind": "console_script",
     "file": "%APPDATA%\\UnrealVRMod\\{exe_stem}\\user_script.txt", "key": "sg.PostProcessQuality",
     "steps": ["0", "1", "2", "3"], "default": 3, "floor": 0, "shows": 1, "cost": 2, "live": "uevr_http", "restart": false},
    {"id": "effects", "label": "Effects (smoke, sparks, particles)", "kind": "console_script",
     "file": "%APPDATA%\\UnrealVRMod\\{exe_stem}\\user_script.txt", "key": "sg.EffectsQuality",
     "steps": ["0", "1", "2", "3"], "default": 3, "floor": 1, "shows": 1, "cost": 2, "live": "uevr_http", "restart": false},
    {"id": "reflections", "label": "Reflections (Unreal 5)", "kind": "console_script",
     "file": "%APPDATA%\\UnrealVRMod\\{exe_stem}\\user_script.txt", "key": "sg.ReflectionQuality",
     "steps": ["0", "1", "2", "3"], "default": 3, "floor": 0, "shows": 1, "cost": 2, "live": "uevr_http", "restart": false},
    {"id": "foliage", "label": "Grass and plants", "kind": "console_script",
     "file": "%APPDATA%\\UnrealVRMod\\{exe_stem}\\user_script.txt", "key": "sg.FoliageQuality",
     "steps": ["0", "1", "2", "3"], "default": 3, "floor": 1, "shows": 2, "cost": 2, "cpu": true, "live": "uevr_http", "restart": false},
    {"id": "view_distance", "label": "View distance", "kind": "console_script",
     "file": "%APPDATA%\\UnrealVRMod\\{exe_stem}\\user_script.txt", "key": "sg.ViewDistanceQuality",
     "steps": ["0", "1", "2", "3"], "default": 3, "floor": 1, "shows": 2, "cost": 2, "cpu": true, "live": "uevr_http", "restart": false},
    {"id": "textures", "label": "Textures", "kind": "console_script",
